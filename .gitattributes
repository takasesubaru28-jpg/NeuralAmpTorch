# VST bundles contain executable libraries and trained model files. Store the
# large artifacts with Git LFS so a complete, loadable distribution can be
# published without GitHub's normal per-file size limit.
*.dll filter=lfs diff=lfs merge=lfs -text
*.vst3 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text


{
  "model": {
    "type": "wavenet",
    "onnx_name": "stateful_wavenet_nogan",
    "param_dim": 4,
    "channels": 32,
    "num_layers": 9,
    "kernel_size": 3,
    "param_embedding": 32,
    "output_mode": "direct"
  },
  "paths": {
    "input_wav": "../../Shared/Data/main/input/input.wav",
    "target_dir": "../../Shared/Data/main/target"
  },
  "audio": {
    "sample_rate": 44100
  },
  "training": {
    "sequence_length": 2048,
    "batch_size": 4,
    "samples_per_epoch": 4000,
    "learning_rate": 0.0003,
    "weight_decay": 0.000001,
    "clip_grad": 1,
    "num_workers": 0,
    "pin_memory": false,
    "max_cuda_memory_fraction": 0.7,
    "step_pause_ms": 0,
    "resume": true
  },
  "loss": {
    "time_weight": 1,
    "esr_weight": 0.1,
    "stft_weight": 1
  },
  "convergence": {
    "minimum_epochs": 150,
    "max_epochs": 0,
    "patience": 50,
    "min_delta_ratio": 0.0001,
    "lr_patience": 15,
    "lr_factor": 0.5,
    "min_learning_rate": 0.000001
  },
  "monitoring": {
    "validation_target_count": 10,
    "validation_batches": 20,
    "log_every_steps": 50,
    "evaluation_interval_epochs": 5,
    "evaluation_seconds": 10
  },
  "gan": {
    "enabled": false
  },
  "export": {
    "block_size": 64,
    "opset": 18
  },
  "experiment_name": "stateful_wavenet_direct_nogan"
}
